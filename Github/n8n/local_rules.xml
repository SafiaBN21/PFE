<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>
</group>

<group name="n8n,">
  <rule id="100211" level="12">
    <decoded_as>json</decoded_as>
    <field name="alert_type">Email Compromis</field>
    <field name="risque">low|medium|high|critical</field>
    <description>Email compromis détecté par n8n</description>
  </rule>
  <rule id="100212" level="5">
    <decoded_as>json</decoded_as>
    <field name="alert_type">Email safe</field>
    <description>Email safe : aucune fuite detectee </description>
  </rule>
  <rule id="100213" level="3">
    <decoded_as>json</decoded_as>
    <field name="alert_type">Email non traite</field>
    <description>Email non traite : erreur API ou timeout </description>
  </rule>
   <rule id="100214" level="12">
 <decoded_as>json</decoded_as>
 <field name="alert_type">NOTIFICATION</field>
 <description>Rapport généré pour les Emails Compromis</description>
 </rule>
 
</group>


<group name="malware,virustotal">

  <rule id="100085" level="15">
    <if_sid>87105</if_sid>
    <description>Malware détecté par VirusTotal </description>
    <group>malware,virustotal,xdr</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>
    <rule id="100090" level="15" ignore="120">
    <if_sid>100085</if_sid>
    <field name="virustotal.source.file" type="pcre2">\\</field>
    <description>Malware détecté par VirusTotal (Windows)</description>
    <group>malware,virustotal,xdr,windows</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>

  <rule id="100091" level="15" ignore="120">
    <if_sid>100085</if_sid>
    <field name="virustotal.source.file" type="pcre2">^/</field>
    <description>Malware détecté par VirusTotal (Linux)</description>
    <group>malware,virustotal,xdr,linux</group>
    <mitre>
      <id>T1204</id>
    </mitre>
  </rule>
</group>
  <group name="malware,active-response">
  <rule id="100086" level="8">
    <decoded_as>remove-malware-xdr</decoded_as>
    <description>Active Response remove-malware : fichier supprimé avec succès</description>
  </rule>
</group>

<group name="windows,authentication_failed,brute_force">
  <rule id="100087" level="10" frequency="3" timeframe="60" ignore="120">
    <if_matched_sid>60122</if_matched_sid>
    <description>Brute force RDP détecté</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,brute_force</group>
  </rule>
</group>


<group name="active_directory,kerberoasting,">
  <rule id="100132" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>Kerberoasting détecté : demande de ticket Kerberos avec chiffrement RC4 (faible) pour le service $(win.eventdata.serviceName), par le compte $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>attack,gstr,</group>
  </rule>
</group>
<group name="active_directory,dcsync,">

  <rule id="100900" level="15">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <field name="win.eventdata.properties" type="pcre2">\{1131f6aa-9c07-11d1-f79f-00c04fc2dcd2\}|\{1131f6ad-9c07-11d1-f79f-00c04fc2dcd2\}|\{89e95b76-444d-4c62-991a-0facbeda640c\}</field>
    <options>no_full_log</options>
    <ignore>120</ignore>
    <description>DCSync détecté : réplication AD demandée par $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1003.006</id>
    </mitre>
    <group>attack,credential_access,gstr</group>
  </rule>
</group>

<group name="active_directory,pass_the_hash,">

  <rule id="100901" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4624$</field>
    <field name="win.eventdata.authenticationPackageName">^NTLM$</field>
    <field name="win.eventdata.logonType">^3$</field>
    <options>no_full_log</options>
    <ignore>120</ignore>
    <description>Pass the Hash : authentification NTLM réseau réussie pour le compte $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1550.002</id>
    </mitre>
    <group>attack,lateral_movement,gstr</group>
  </rule>
</group>

<group name="local,webshell,">
  <rule id="100260" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">/var/www/intranet/uploads/.*\.(php|jsp|asp|aspx)$</field>
    <description>Fichier exécutable suspect déposé dans le répertoire web : possible web shell sur $(file).</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>webshell,</group>
  </rule>
<rule id="100261" level="10">
  <decoded_as>webshell-response</decoded_as>
  <description>CONFIRMATION : Web shell supprimé automatiquement.</description>
  <group>webshell,active_response,</group>
</rule>
</group>

 
