#!/bin/bash
ALERT_FILE=$1
LOG_FILE="/var/ossec/logs/integrations.log"
TEMPLATE="/var/ossec/integrations/email_bruteforce.html"
TMP_HTML="/tmp/brute_force_alert_$$.html"
TMP_MIME="/tmp/brute_force_mime_$$.eml"
EMAIL_TO="safiabn90@gmail.com"
OSSEC_CONF="/var/ossec/etc/ossec.conf"

# --- Logos locaux (places une seule fois sur le manager) ---
LOGO_DIR="/var/ossec/integrations/logos"
WAZUH_LOGO="${LOGO_DIR}/wazuh.png"
MEDI1_LOGO="${LOGO_DIR}/Meditv.jpg"
BOUNDARY="WAZUH_MIME_BOUNDARY_$$"

log() {
    echo "$(date '+%Y/%m/%d %H:%M:%S') notify-brute-force.sh: $1" >> "${LOG_FILE}"
}

log "Script demarre, fichier: ${ALERT_FILE}"
[ ! -f "$ALERT_FILE" ] && { log "ERREUR: fichier introuvable"; exit 1; }

ALERT_JSON=$(cat "$ALERT_FILE")

# --- Recuperation dynamique de la regle Wazuh qui a declenche l'alerte ---
TRIGGERING_RULE=$(echo "$ALERT_JSON" | jq -r '.data.parameters.alert.rule.id // .rule.id // "unknown"')

# --- Extraction dynamique du timeout depuis ossec.conf, selon la vraie regle utilisee ---
DETECTED_TIMEOUT=$(awk -v rule="$TRIGGERING_RULE" '
    /<active-response>/ { in_block=1; timeout=""; matched=0 }
    in_block && /<rules_id>/ { if ($0 ~ rule) matched=1 }
    in_block && /<timeout>/ {
        gsub(/[^0-9]/, "", $0); timeout=$0
    }
    in_block && /<\/active-response>/ {
        if (matched && timeout != "") { print timeout; exit }
        in_block=0
    }
' "$OSSEC_CONF")

if [ -z "$DETECTED_TIMEOUT" ]; then
    DETECTED_TIMEOUT="Non disponible"
fi

if [[ "$DETECTED_TIMEOUT" =~ ^[0-9]+$ ]]; then
    TIMEOUT_DISPLAY="${DETECTED_TIMEOUT} secondes"
else
    TIMEOUT_DISPLAY="${DETECTED_TIMEOUT}"
fi

# Fonction generique : essaie plusieurs chemins JSON dans l'ordre, garde le premier qui repond
extract_multi() {
    local val
    for path in "$@"; do
        val=$(echo "$ALERT_JSON" | jq -r "$path // empty" 2>/dev/null)
        if [ -n "$val" ] && [ "$val" != "null" ]; then
            echo "$val"
            return
        fi
    done
    echo "Non disponible"
}

# --- Detection automatique du protocole ---
IS_WINDOWS=$(echo "$ALERT_JSON" | jq -r '.data.win // .data.parameters.alert.data.win // empty')
if [ -n "$IS_WINDOWS" ]; then
    PROTOCOL="RDP"
else
    PROTOCOL="SSH"
fi

# --- Extraction universelle des champs (Windows RDP + Linux SSH) ---
SOURCE_IP=$(extract_multi \
    '.data.win.eventdata.ipAddress' \
    '.data.parameters.alert.data.win.eventdata.ipAddress' \
    '.data.srcip' \
    '.data.parameters.alert.data.srcip')

SOURCE_NAME=$(extract_multi \
    '.data.win.eventdata.workstationName' \
    '.data.parameters.alert.data.win.eventdata.workstationName')

TARGET_USER=$(extract_multi \
    '.data.win.eventdata.targetUserName' \
    '.data.parameters.alert.data.win.eventdata.targetUserName' \
    '.data.dstuser' \
    '.data.parameters.alert.data.dstuser' \
    '.data.srcuser' \
    '.data.parameters.alert.data.srcuser')

ATTEMPT_COUNT=$(extract_multi \
    '.rule.frequency' \
    '.data.parameters.alert.rule.frequency')

TARGET_NAME=$(extract_multi \
    '.agent.name' \
    '.data.parameters.alert.agent.name')

TARGET_IP=$(extract_multi \
    '.agent.ip' \
    '.data.parameters.alert.agent.ip')

# --- Heure exacte de declenchement de la brute-force (UTC -> UTC+1) ---
TIMESTAMP_RAW=$(extract_multi \
    '.data.parameters.alert.timestamp' \
    '.timestamp')

TRIGGER_TIME=$(python3 -c "
import re
from datetime import datetime, timezone, timedelta

try:
    ts = '${TIMESTAMP_RAW}'
    ts = re.sub(r'([+-])(\d{2})(\d{2})$', r'\1\2:\3', ts.replace('Z', '+00:00'))
    dt = datetime.fromisoformat(ts)
    local = dt.astimezone(timezone(timedelta(hours=1)))
    print(local.strftime('%Y-%m-%d %H:%M:%S'))
except Exception:
    print('${TIMESTAMP_RAW}')
")

# --- MITRE ATT&CK combine (Tactique + ID) ---
MITRE_TACTIC=$(echo "$ALERT_JSON" | jq -r '(.data.parameters.alert.rule.mitre.tactic // .rule.mitre.tactic // ["Non disponible"]) | join(", ")' 2>/dev/null)
MITRE_ID=$(echo "$ALERT_JSON" | jq -r '(.data.parameters.alert.rule.mitre.id // .rule.mitre.id // ["Non disponible"]) | join(", ")' 2>/dev/null)
MITRE_DISPLAY="${MITRE_TACTIC} (${MITRE_ID})"

# --- Affichage adapte : si le nom de la machine attaquante est inconnu (cas SSH), n'affiche que l'IP ---
if [ "$SOURCE_NAME" = "Non disponible" ]; then
    SOURCE_DISPLAY="${SOURCE_IP}"
else
    SOURCE_DISPLAY="${SOURCE_NAME} : ${SOURCE_IP}"
fi

log "Extraction: protocol=${PROTOCOL} source=${SOURCE_DISPLAY} target=${TARGET_NAME}(${TARGET_IP}) user=${TARGET_USER} tentatives=${ATTEMPT_COUNT} mitre=${MITRE_DISPLAY}"

# --- Uniquement SSH (5763) et RDP (100087) declenchent un email ---
RULE_ID=$(echo "$ALERT_JSON" | jq -r '.rule.id // "unknown"')
if [ "$RULE_ID" = "5763" ] || [ "$RULE_ID" = "100087" ]; then
    EMAIL_TITLE="Wazuh Active Response : Détection de Brute Force et Blocage Automatique"
    UNIQUE_ID=$(date '+%Y%m%d-%H%M%S')
    EMAIL_SUBJECT="[Wazuh XDR] Brute Force ${PROTOCOL} : Blocage IP ${SOURCE_IP} sur la machine ${TARGET_NAME} - ${UNIQUE_ID}"
    HEADER_COLOR="#c0392b"
    INTRO_TEXT="Une attaque brute force a été detectée par Wazuh et l'adresse IP de l'attaquant a été bloquée automatiquement."
    STATUS_TEXT="Blocage"; STATUS_COLOR="#c0392b"
else
    log "Règle ${RULE_ID} ignoree (non concernee)"
    exit 0
fi

# --- Verification presence des logos ---
if [ ! -f "$WAZUH_LOGO" ] || [ ! -f "$MEDI1_LOGO" ]; then
    log "ATTENTION: logo(s) introuvable(s) dans ${LOGO_DIR}, email envoye sans images inline"
fi

sed \
    -e "s|__EMAIL_TITLE__|${EMAIL_TITLE}|g" \
    -e "s/__HEADER_COLOR__/${HEADER_COLOR}/g" \
    -e "s|__INTRO_TEXT__|${INTRO_TEXT}|g" \
    -e "s/__PROTOCOL__/${PROTOCOL}/g" \
    -e "s|__SOURCE_DISPLAY__|${SOURCE_DISPLAY}|g" \
    -e "s/__SOURCE_IP__/${SOURCE_IP}/g" \
    -e "s|__TARGET_NAME__|${TARGET_NAME}|g" \
    -e "s/__TARGET_IP__/${TARGET_IP}/g" \
    -e "s|__TARGET_USER__|${TARGET_USER}|g" \
    -e "s/__ATTEMPT_COUNT__/${ATTEMPT_COUNT}/g" \
    -e "s|__TIMEOUT_DISPLAY__|${TIMEOUT_DISPLAY}|g" \
    -e "s|__STATUS_TEXT__|${STATUS_TEXT}|g" \
    -e "s/__STATUS_COLOR__/${STATUS_COLOR}/g" \
    -e "s|__TRIGGER_TIME__|${TRIGGER_TIME}|g" \
    -e "s|__MITRE_DISPLAY__|${MITRE_DISPLAY}|g" \
    "$TEMPLATE" > "$TMP_HTML"

# --- Construction de l'email MIME multipart/related (HTML + images inline) ---
{
    echo "To: ${EMAIL_TO}"
    echo "Subject: ${EMAIL_SUBJECT}"
    echo "MIME-Version: 1.0"
    echo "Content-Type: multipart/related; boundary=\"${BOUNDARY}\""
    echo ""
    echo "--${BOUNDARY}"
    echo "Content-Type: text/html; charset=UTF-8"
    echo "Content-Transfer-Encoding: 7bit"
    echo ""
    cat "$TMP_HTML"
    echo ""

    if [ -f "$WAZUH_LOGO" ]; then
        echo "--${BOUNDARY}"
        echo "Content-Type: image/png"
        echo "Content-Transfer-Encoding: base64"
        echo "Content-ID: <logo_wazuh>"
        echo "Content-Disposition: inline; filename=\"wazuh.png\""
        echo ""
        base64 "$WAZUH_LOGO"
        echo ""
    fi

    if [ -f "$MEDI1_LOGO" ]; then
        echo "--${BOUNDARY}"
        echo "Content-Type: image/png"
        echo "Content-Transfer-Encoding: base64"
        echo "Content-ID: <logo_medi1>"
        echo "Content-Disposition: inline; filename=\"medi1tv.png\""
        echo ""
        base64 "$MEDI1_LOGO"
        echo ""
    fi

    echo "--${BOUNDARY}--"
} > "$TMP_MIME"

ssmtp "${EMAIL_TO}" < "$TMP_MIME"

log "Email envoye (regle=${RULE_ID}, protocole=${PROTOCOL}, timeout=${DETECTED_TIMEOUT})"
rm -f "$TMP_HTML" "$TMP_MIME"
exit 0
