#!/bin/bash
# =============================================================================
# Script d'intégration Wazuh — Notification Email Kerberoasting
# Chemin    : /var/ossec/integrations/custom-kerberoasting-alert.sh
# Template  : /var/ossec/integrations/kerberoasting_template.html
# Logos     : /var/ossec/integrations/logos/wazuh.png
#             /var/ossec/integrations/logos/AD.png
#             /var/ossec/integrations/logos/Meditv.jpg
# =============================================================================

ALERT_FILE=$1
LOG_FILE="/var/ossec/logs/integrations.log"
TEMPLATE="/var/ossec/integrations/kerberoasting_template.html"
TMP_HTML="/tmp/kerberoasting_alert_$$.html"
TMP_MIME="/tmp/kerberoasting_mime_$$.eml"
EMAIL_TO="benalisafia99@gmail.com"
RULE_ID="100132"

# --- Logos ---
LOGO_DIR="/var/ossec/integrations/logos"
WAZUH_LOGO="${LOGO_DIR}/wazuh.png"
AD_LOGO="${LOGO_DIR}/AD.png"
MEDI1_LOGO="${LOGO_DIR}/Meditv.jpg"

BOUNDARY="WAZUH_MIME_BOUNDARY_$$"

# =============================================================================
# FONCTIONS
# =============================================================================

log() {
    echo "$(date '+%Y/%m/%d %H:%M:%S') notify-kerberoasting-alert.sh: $1" >> "${LOG_FILE}"
}

# Extraction JSON via Python3 (gère les caractères Windows invalides)
extract() {
    local FIELD=$1
    python3 -c "
import json, sys
try:
    d = json.loads(open('${ALERT_FILE}', encoding='utf-8', errors='replace').read())
    keys = '${FIELD}'.split('.')
    val = d
    for k in keys:
        val = val.get(k, {}) if isinstance(val, dict) else {}
    print(val if val not in [{}, None, ''] else 'N/A')
except Exception as e:
    print('N/A')
"
}

build_image_part() {
    local FILE=$1
    local CID=$2
    local FILENAME
    FILENAME=$(basename "$FILE")
    local EXT="${FILENAME##*.}"
    local MIME_TYPE="image/png"
    case "${EXT,,}" in
        jpg|jpeg) MIME_TYPE="image/jpeg" ;;
        png)      MIME_TYPE="image/png"  ;;
    esac
    {
        echo "--${BOUNDARY}"
        echo "Content-Type: ${MIME_TYPE}; name=\"${FILENAME}\""
        echo "Content-Transfer-Encoding: base64"
        echo "Content-ID: <${CID}>"
        echo "Content-Disposition: inline; filename=\"${FILENAME}\""
        echo ""
        base64 "$FILE"
        echo ""
    } >> "$TMP_MIME"
}

# =============================================================================
# DEBUT DU SCRIPT
# =============================================================================

log "Script demarre, fichier: ${ALERT_FILE}"

[ ! -f "$ALERT_FILE" ] && { log "ERREUR: fichier introuvable"; exit 1; }

# --- Vérifier que c'est bien la règle Kerberoasting ---
ALERT_RULE_ID=$(python3 -c "
import json
try:
    d = json.loads(open('${ALERT_FILE}', encoding='utf-8', errors='replace').read())
    print(str(d.get('rule', {}).get('id', '')))
except:
    print('')
")

log "Regle detectee: ${ALERT_RULE_ID}"

if [ "$ALERT_RULE_ID" != "$RULE_ID" ]; then
    log "Ignore: regle ${ALERT_RULE_ID} differente de ${RULE_ID}"
    exit 0
fi

# =============================================================================
# EXTRACTION DES CHAMPS (Python3 — gère les caractères spéciaux Windows)
# =============================================================================

TIMESTAMP_RAW=$(extract "timestamp")

TIMESTAMP=$(python3 -c "
import re
from datetime import datetime, timezone, timedelta

try:
    ts = '${TIMESTAMP_RAW}'
    ts = re.sub(r'([+-])(\d{2})(\d{2})$', r'\1\2:\3', ts.replace('Z', '+00:00'))
    dt = datetime.fromisoformat(ts)

    local = dt.astimezone(timezone(timedelta(hours=1)))

    print(local.strftime('%Y-%m-%d %H:%M:%S'))
except Exception as e:
    print('${TIMESTAMP_RAW}')
")

RULE_LEVEL=$(extract "rule.level")
EVENT_ID=$(extract "data.win.system.eventID")
COMPUTER=$(extract "data.win.system.computer")
RECORD_ID=$(extract "data.win.system.eventRecordID")
DOMAIN=$(extract "data.win.eventdata.targetDomainName")
SERVICE_NAME=$(extract "data.win.eventdata.serviceName")
ENCRYPTION_TYPE=$(extract "data.win.eventdata.ticketEncryptionType")

# IP — nettoyage du préfixe ::ffff:
IP_RAW=$(extract "data.win.eventdata.ipAddress")
IP_ADDRESS=$(echo "$IP_RAW" | sed 's/::ffff://')

# Compte attaquant — extraire uniquement la partie avant le @
ATTACKER_ACCOUNT_RAW=$(extract "data.win.eventdata.targetUserName")
ATTACKER_ACCOUNT="${ATTACKER_ACCOUNT_RAW%%@*}"

# SPN complet — non disponible dans Event 4769, on le reconstruit
SPN_FULL_RAW=$(extract "data.win.eventdata.servicePrincipalName")
if [ "$SPN_FULL_RAW" = "N/A" ]; then
    SPN_FULL="${SERVICE_NAME}/${COMPUTER}"
else
    SPN_FULL="$SPN_FULL_RAW"
fi

log "Alerte Kerberoasting: ${ATTACKER_ACCOUNT} -> ${SERVICE_NAME} (${DOMAIN}) depuis ${IP_ADDRESS}"

# =============================================================================
# ENRICHISSEMENT LDAP (memberOf, pwdLastSet, whenCreated)
# =============================================================================

LDAP_SERVER="192.168.56.30"
LDAP_BASE="DC=gstr,DC=local"
LDAP_USER="administrateur@gstr.local"
LDAP_PASS="Safia21@"

LDAP_RESULT=$(ldapsearch \
    -x -LLL -o ldif-wrap=no \
    -H ldap://${LDAP_SERVER} \
    -D "${LDAP_USER}" \
    -w "${LDAP_PASS}" \
    -b "${LDAP_BASE}" \
    "(sAMAccountName=${SERVICE_NAME})" \
    memberOf pwdLastSet whenCreated description 2>>"$LOG_FILE")

[ -z "$LDAP_RESULT" ] && log "ATTENTION: ldapsearch vide pour ${SERVICE_NAME}"

# Membre de
MEMBER_OF=$(echo "$LDAP_RESULT" | grep "^memberOf:" | head -1 | cut -d' ' -f2-)
[ -z "$MEMBER_OF" ] && MEMBER_OF="Aucun groupe secondaire"

# PasswordLastSet — conversion FILETIME Windows → date lisible
PWD_LAST_SET_RAW=$(echo "$LDAP_RESULT" | grep "^pwdLastSet:" | awk '{print $2}')
if [ -z "$PWD_LAST_SET_RAW" ]; then
    PWD_LAST_SET="N/A"
elif [ "$PWD_LAST_SET_RAW" = "0" ]; then
    PWD_LAST_SET="Changement requis a la prochaine connexion"
else
    UNIX_TS=$(( PWD_LAST_SET_RAW / 10000000 - 11644473600 ))
    PWD_LAST_SET=$(date -d "@${UNIX_TS}" '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null)
    [ -z "$PWD_LAST_SET" ] && PWD_LAST_SET="N/A"
fi

# whenCreated — format LDAP AAAAMMJJHHMMSS.0Z
WHEN_CREATED_RAW=$(echo "$LDAP_RESULT" | grep "^whenCreated:" | awk '{print $2}')
if [[ "$WHEN_CREATED_RAW" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})([0-9]{2})([0-9]{2})([0-9]{2}) ]]; then
    WHEN_CREATED="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]} ${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]} UTC"
else
    WHEN_CREATED="N/A"
fi

# =============================================================================
# GÉNÉRATION DU HTML
# =============================================================================

[ ! -f "$TEMPLATE" ] && { log "ERREUR: template introuvable ${TEMPLATE}"; exit 1; }

for LOGO in "$WAZUH_LOGO" "$AD_LOGO" "$MEDI1_LOGO"; do
    [ ! -f "$LOGO" ] && { log "ERREUR: logo introuvable ${LOGO}"; exit 1; }
done

sed \
    -e "s|{{TIMESTAMP}}|${TIMESTAMP}|g" \
    -e "s|{{EVENT_ID}}|${EVENT_ID}|g" \
    -e "s|{{COMPUTER}}|${COMPUTER}|g" \
    -e "s|{{ATTACKER_ACCOUNT}}|${ATTACKER_ACCOUNT}|g" \
    -e "s|{{IP_ADDRESS}}|${IP_ADDRESS}|g" \
    -e "s|{{SERVICE_NAME}}|${SERVICE_NAME}|g" \
    -e "s|{{SPN_FULL}}|${SPN_FULL}|g" \
    -e "s|{{MEMBER_OF}}|${MEMBER_OF}|g" \
    -e "s|{{PWD_LAST_SET}}|${PWD_LAST_SET}|g" \
    -e "s|{{WHEN_CREATED}}|${WHEN_CREATED}|g" \
    -e "s|{{DOMAIN}}|${DOMAIN}|g" \
    -e "s|{{ENCRYPTION_TYPE}}|${ENCRYPTION_TYPE}|g" \
    -e "s|{{RULE_ID}}|${ALERT_RULE_ID}|g" \
    -e "s|{{RULE_LEVEL}}|${RULE_LEVEL}|g" \
    -e "s|{{RECORD_ID}}|${RECORD_ID}|g" \
    "$TEMPLATE" > "$TMP_HTML"

# =============================================================================
# CONSTRUCTION DU MIME ET ENVOI
# =============================================================================

{
    echo "From: wazuh@gstr.local"
    echo "To: ${EMAIL_TO}"
    echo "Subject: [Wazuh] Kerberoasting Detecte - ${ATTACKER_ACCOUNT} -> ${SERVICE_NAME} - ${DOMAIN}"
    echo "MIME-Version: 1.0"
    echo "Content-Type: multipart/related; boundary=\"${BOUNDARY}\""
    echo ""
    echo "--${BOUNDARY}"
    echo "Content-Type: text/html; charset=UTF-8"
    echo "Content-Transfer-Encoding: 8bit"
    echo ""
    cat "$TMP_HTML"
    echo ""
} > "$TMP_MIME"

build_image_part "$WAZUH_LOGO" "wazuh_logo"
build_image_part "$AD_LOGO"    "ad_logo"
build_image_part "$MEDI1_LOGO" "medi1_logo"

echo "--${BOUNDARY}--" >> "$TMP_MIME"

/usr/sbin/ssmtp "$EMAIL_TO" < "$TMP_MIME"

if [ $? -eq 0 ]; then
touch "/tmp/kerberoasting_email_lock"
    log "OK: email envoye a ${EMAIL_TO}"
else
    log "ERREUR: echec de l'envoi via ssmtp"
fi

# =============================================================================
# NETTOYAGE
# =============================================================================

rm -f "$TMP_HTML" "$TMP_MIME"
exit 0
