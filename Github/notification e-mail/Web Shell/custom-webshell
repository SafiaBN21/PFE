#!/bin/bash
# =============================================================================
# Script d'intégration Wazuh — Notification Email Web Shell
# Chemin    : /var/ossec/integrations/custom-webshell-alert.sh
# Template  : /var/ossec/integrations/webshell_template.html
# Logos     : /var/ossec/integrations/logos/wazuh.png
#             /var/ossec/integrations/logos/Meditv.jpg
# =============================================================================

ALERT_FILE=$1
LOG_FILE="/var/ossec/logs/integrations.log"
TEMPLATE="/var/ossec/integrations/webshell.html"
TMP_HTML="/tmp/webshell_alert_$$.html"
TMP_MIME="/tmp/webshell_mime_$$.eml"
EMAIL_TO="benalisafia99@gmail.com"
RULE_ID_DETECTION="100260"

LOGO_WAZUH="/var/ossec/integrations/logos/wazuh.png"
LOGO_MEDITV="/var/ossec/integrations/logos/Meditv.jpg"

# --- Identifiants API Wazuh (pour recuperer les infos OS via syscollector) ---
WAZUH_API_HOST="192.168.56.20"
WAZUH_API_USER="wazuh-wui"
WAZUH_API_PASS="wazuh-wui"

echo "$(date '+%Y-%m-%d %H:%M:%S') custom-webshell-alert.sh: Script declenche" >> ${LOG_FILE}

# -----------------------------------------------------------------------------
# Extraction des champs depuis l'alerte JSON
# -----------------------------------------------------------------------------
RULE_ID=$(cat ${ALERT_FILE} | jq -r '.rule.id')
AGENT_ID=$(cat ${ALERT_FILE} | jq -r '.agent.id')
AGENT_NAME=$(cat ${ALERT_FILE} | jq -r '.agent.name')
AGENT_IP=$(cat ${ALERT_FILE} | jq -r '.agent.ip')
TIMESTAMP_RAW=$(cat "${ALERT_FILE}" | jq -r '.timestamp')

TIMESTAMP=$(python3 -c "
import re
from datetime import datetime, timezone, timedelta

try:
    ts = '${TIMESTAMP_RAW}'
    ts = re.sub(r'([+-])(\d{2})(\d{2})$', r'\1\2:\3', ts.replace('Z', '+00:00'))
    dt = datetime.fromisoformat(ts)

    local = dt.astimezone(timezone(timedelta(hours=1)))

    print(local.strftime('%Y-%m-%d %H:%M:%S'))
except Exception:
    print('${TIMESTAMP_RAW}')
")
FILE_PATH=$(cat ${ALERT_FILE} | jq -r '.syscheck.path // "N/A"')
MITRE_ID=$(cat ${ALERT_FILE} | jq -r '.rule.mitre.id[0] // "N/A"')
MITRE_TECHNIQUE=$(cat ${ALERT_FILE} | jq -r '.rule.mitre.technique[0] // "N/A"')
MITRE_TACTIC=$(cat ${ALERT_FILE} | jq -r '.rule.mitre.tactic[0] // "N/A"')

FILE_SHA256=$(cat ${ALERT_FILE} | jq -r '.syscheck.sha256_after // "N/A"')
FILE_OWNER=$(cat ${ALERT_FILE} | jq -r '.syscheck.uname_after // "N/A"')

# -----------------------------------------------------------------------------
# Ne traiter que l'alerte de detection (100260) - une seule notification
# -----------------------------------------------------------------------------
if [ "${RULE_ID}" != "${RULE_ID_DETECTION}" ]; then
    exit 0
fi

STATUT="DÉTÉCTÉ"
COULEUR_STATUT="#8B0000"
ACTION="remove-webshell — suppression automatique du fichier"

# -----------------------------------------------------------------------------
# Informations systeme de la machine ciblee, via l'API Wazuh (syscollector)
# -----------------------------------------------------------------------------
TOKEN=$(curl -s -k -u "${WAZUH_API_USER}:${WAZUH_API_PASS}" \
  -X POST "https://${WAZUH_API_HOST}:55000/security/user/authenticate" | jq -r '.data.token')

if [ -n "${TOKEN}" ] && [ "${TOKEN}" != "null" ]; then
  OS_DATA=$(curl -s -k -X GET "https://${WAZUH_API_HOST}:55000/agents?agents_list=${AGENT_ID}" \
    -H "Authorization: Bearer ${TOKEN}" | jq '.data.affected_items[0].os')
  OS_NAME=$(echo "${OS_DATA}" | jq -r '.name // "N/A"')
  OS_VERSION=$(echo "${OS_DATA}" | jq -r '.version // "N/A"')
  OS_ARCH=$(echo "${OS_DATA}" | jq -r '.arch // "N/A"')
else
  OS_NAME="N/A"
  OS_VERSION="N/A"
  OS_ARCH="N/A"
fi

echo "$(date '+%Y-%m-%d %H:%M:%S') custom-webshell-alert.sh: OS recupere -> ${OS_NAME} ${OS_VERSION} (${OS_ARCH})" >> ${LOG_FILE}

# Version Apache exposee par le serveur cible
APACHE_VERSION=$(curl -sI --max-time 3 "http://${AGENT_IP}/" 2>/dev/null | grep -i "^Server:" | cut -d' ' -f2- | tr -d '\r')
APACHE_VERSION=${APACHE_VERSION:-"Non identifiee"}

# URL du site concerne
SITE_URL="http://${AGENT_IP}/intranet/"

# -----------------------------------------------------------------------------
# IP de la machine attaquante, via correlation avec les logs Apache remontes
# -----------------------------------------------------------------------------
ATTACKER_IP=$(grep -a "$(basename ${FILE_PATH})" /var/ossec/logs/archives/archives.json 2>/dev/null \
              | grep -a "PUT" | tail -1 | jq -r '.data.srcip // empty' 2>/dev/null)
ATTACKER_IP=${ATTACKER_IP:-"Non identifiee"}

# -----------------------------------------------------------------------------
# Generation du contenu HTML a partir du template
# -----------------------------------------------------------------------------
cp "${TEMPLATE}" "${TMP_HTML}"

sed -i "s|{{STATUT}}|${STATUT}|g"                     "${TMP_HTML}"
sed -i "s|{{COULEUR_STATUT}}|${COULEUR_STATUT}|g"      "${TMP_HTML}"
sed -i "s|{{AGENT_NAME}}|${AGENT_NAME}|g"              "${TMP_HTML}"
sed -i "s|{{AGENT_IP}}|${AGENT_IP}|g"                  "${TMP_HTML}"
sed -i "s|{{TIMESTAMP}}|${TIMESTAMP}|g"                "${TMP_HTML}"
sed -i "s|{{FILE_PATH}}|${FILE_PATH}|g"                "${TMP_HTML}"
sed -i "s|{{MITRE_ID}}|${MITRE_ID}|g"                  "${TMP_HTML}"
sed -i "s|{{MITRE_TECHNIQUE}}|${MITRE_TECHNIQUE}|g"    "${TMP_HTML}"
sed -i "s|{{MITRE_TACTIC}}|${MITRE_TACTIC}|g"          "${TMP_HTML}"
sed -i "s|{{FILE_SHA256}}|${FILE_SHA256}|g"            "${TMP_HTML}"
sed -i "s|{{FILE_OWNER}}|${FILE_OWNER}|g"              "${TMP_HTML}"
sed -i "s|{{OS_NAME}}|${OS_NAME}|g"                    "${TMP_HTML}"
sed -i "s|{{OS_VERSION}}|${OS_VERSION}|g"              "${TMP_HTML}"
sed -i "s|{{OS_ARCH}}|${OS_ARCH}|g"                    "${TMP_HTML}"
sed -i "s|{{APACHE_VERSION}}|${APACHE_VERSION}|g"      "${TMP_HTML}"
sed -i "s|{{SITE_URL}}|${SITE_URL}|g"                  "${TMP_HTML}"
sed -i "s|{{ATTACKER_IP}}|${ATTACKER_IP}|g"            "${TMP_HTML}"
sed -i "s|{{ACTION}}|${ACTION}|g"                      "${TMP_HTML}"

# -----------------------------------------------------------------------------
# Construction du mail MIME avec logos integres (inline)
# -----------------------------------------------------------------------------
BOUNDARY="XDR-WEBSHELL-BOUNDARY-$$"
SUBJECT="[Wazuh XDR] Web Shell ${STATUT} - ${AGENT_NAME} (${FILE_PATH})"

{
  echo "From: Wazuh XDR <alert@xdr.local>"
  echo "To: ${EMAIL_TO}"
  echo "Subject: ${SUBJECT}"
  echo "MIME-Version: 1.0"
  echo "Content-Type: multipart/related; boundary=\"${BOUNDARY}\""
  echo ""
  echo "--${BOUNDARY}"
  echo "Content-Type: text/html; charset=UTF-8"
  echo "Content-Transfer-Encoding: 7bit"
  echo ""
  cat "${TMP_HTML}"
  echo ""

  if [ -f "${LOGO_WAZUH}" ]; then
    echo "--${BOUNDARY}"
    echo "Content-Type: image/png"
    echo "Content-Transfer-Encoding: base64"
    echo "Content-ID: <logo_wazuh>"
    echo "Content-Disposition: inline; filename=\"wazuh.png\""
    echo ""
    base64 "${LOGO_WAZUH}"
    echo ""
  fi

  if [ -f "${LOGO_MEDITV}" ]; then
    echo "--${BOUNDARY}"
    echo "Content-Type: image/jpeg"
    echo "Content-Transfer-Encoding: base64"
    echo "Content-ID: <logo_meditv>"
    echo "Content-Disposition: inline; filename=\"Meditv.jpg\""
    echo ""
    base64 "${LOGO_MEDITV}"
    echo ""
  fi

  echo "--${BOUNDARY}--"
} > "${TMP_MIME}"

# -----------------------------------------------------------------------------
# Envoi
# -----------------------------------------------------------------------------
/usr/sbin/sendmail -t < "${TMP_MIME}"

if [ $? -eq 0 ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S') custom-webshell-alert.sh: Email envoye avec succes pour la regle ${RULE_ID}" >> ${LOG_FILE}
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') custom-webshell-alert.sh: ECHEC de l'envoi de l'email" >> ${LOG_FILE}
fi

rm -f "${TMP_HTML}" "${TMP_MIME}"

exit 0
